{
  "name": "@ai-ascension/ascension-workflow-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.16.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "npm run typecheck",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:effective-limits-browser": "playwright test --config playwright.effective-limits.config.ts",
    "test:live-owner-browser": "npm run build && node --test tools/live-owner-test-server.test.mjs && playwright test --config playwright.live-owner.config.ts",
    "test:production-policy-browser": "npm run build && node tools/production-policy-browser.mjs",
    "test:owner-restart": "node --test tests/process/at-046-owner-restart.test.mjs",
    "test:owner-negative-auth": "node --test tests/process/studio109-owner-negative-auth.test.mjs",
    "test:recorded-browser": "playwright test --config playwright.recorded.config.ts",
    "recording:inspect": "node tools/inspect-recording.mjs",
    "test:watch": "vitest",
    "preview": "vite preview"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "@xyflow/react": "12.11.6",
    "ajv": "8.20.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
