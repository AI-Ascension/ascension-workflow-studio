{
  "compilerOptions": {
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@studio/contracts": ["./packages/contracts/src/index.ts"],
      "@studio/document": ["./packages/document/src/index.ts"],
      "@studio/client": ["./packages/client/src/index.ts"]
    },
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noEmit": true,
    "types": ["node", "@playwright/test"]
  },
  "include": ["vite.config.ts", "vite.effective-limits.config.ts", "vitest.config.ts", "playwright.config.ts", "playwright.recorded.config.ts", "playwright.effective-limits.config.ts", "tests/browser"]
}
